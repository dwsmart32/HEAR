# Copy to .env and fill in only the keys for the API models you plan to run.
# Local / vLLM models need none of these.
#
#   cp .env.example .env

# gpt-4o-audio
OPENAI_API_KEY=sk-your-key-here

# gemini-3-pro, gemini-3-flash, gemini-2.5-pro
GOOGLE_API_KEY=your-key-here

# Optional: where the spoken option letters A.wav..E.wav live.
# Defaults to assets/prompt_audio in this repo.
# HEAR_PROMPT_AUDIO_DIR=/path/to/prompt_audio
